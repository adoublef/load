# -------------------------------------------------------------
# Docker context allowlist (Ignore everything, allow build files)
# -------------------------------------------------------------

# 1. Ignore everything by default
/*

# 2. Allow directories so Docker can descend into them
!/**/

# 3. Allow only files required for the Docker build
!go.mod
!go.sum
!*.go
!internal/**
!cmd/**
!pkg/**
!Dockerfile
!authorized_keys

# Never send local Git history, root SSH host keys, or env files
/.git
/.github
/ssh/
*.pem
*.key
*.env
