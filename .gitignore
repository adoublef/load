# -------------------------------------------------------------
# Allowlist pattern (Ignore everything, allow specific files)
# -------------------------------------------------------------

# 1. Ignore everything in the root
/*

# 2. Allow all directories so Git can traverse into subdirectories
!/**/

# 3. Track version control & project metadata
!.gitignore
!.dockerignore
!fly.toml
!README.md
!.github/**

# 4. Track Go source code & modules
!go.mod
!go.sum
!*.go
!internal/**
!cmd/**
!pkg/**

# 5. Track container definitions
!Dockerfile
!authorized_keys

# Safety rules: Ignore root host keys or local environment files
/ssh/
*.pem
*.key
*.env
